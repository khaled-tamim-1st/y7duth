# Supabase PostgreSQL Connection String
# انسخ رابط الاتصال من لوحة تحكم Supabase: Project Settings -> Database -> Connection string -> URI
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# مفتاح سري لتشفير جلسات تسجيل الدخول في لوحة التحكم
ADMIN_SECRET_KEY="kuwait-happening-secret-admin-session-key-2026"

# اسم المستخدم وكلمة المرور الافتراضية للوحة التحكم (يمكنك تعديلها)
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_PASSWORD="kuwait@admin2026"

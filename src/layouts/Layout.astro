---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SearchModal from '@/components/SearchModal.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  dateModified?: string;
  breadcrumbs?: Array<{ name: string; url: string }>;
  article?: {
    author: string;
    date: string;
    dateModified?: string;
    category?: string;
  };
}

const {
  title = 'يحدث في الكويت — حكايات المكان وأهله',
  description = 'مجلة مستقلة تنصت للمدينة، وتكتب عن تفاصيلها الصغيرة التي تصنع حكاية كبيرة.',
  image = '/brand/kuwait-logo.png',
  dateModified,
  breadcrumbs,
  article,
} = Astro.props;

const cleanPath = Astro.url.pathname.length > 1 ? Astro.url.pathname.replace(/\/+$/, '') : '/';
const canonicalURL = new URL(cleanPath, Astro.site || 'https://yahduth-fi-al-kuwait.com');

const publisherSchema = {
  "@type": "Organization",
  "name": "يحدث في الكويت",
  "url": "https://yahduth-fi-al-kuwait.com",
  "logo": {
    "@type": "ImageObject",
    "url": "https://yahduth-fi-al-kuwait.com/brand/kuwait-logo.png",
    "width": 64,
    "height": 64,
  },
};

const articleSchema = article
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "inLanguage": "ar-KW",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": canonicalURL.toString(),
      },
      "headline": title,
      "description": description,
      "image": [new URL(image, canonicalURL).toString()],
      "datePublished": article.date,
      "dateModified": article.dateModified || dateModified || article.date,
      "author": {
        "@type": "Person",
        "name": article.author,
      },
      "publisher": publisherSchema,
      ...(article.category ? { "articleSection": article.category } : {}),
    }
  : null;

const websiteSchema = !article
  ? {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "يحدث في الكويت",
      "url": "https://yahduth-fi-al-kuwait.com",
      "description": description,
      "inLanguage": "ar-KW",
      "publisher": publisherSchema,
    }
  : null;

const breadcrumbSchema =
  breadcrumbs && breadcrumbs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": breadcrumbs.map((crumb, idx) => ({
          "@type": "ListItem",
          "position": idx + 1,
          "name": crumb.name,
          "item": crumb.url.startsWith('http')
            ? crumb.url
            : new URL(crumb.url, canonicalURL).toString(),
        })),
      }
    : null;
---

<!doctype html>
<html lang="ar" dir="rtl" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/brand/kuwait-logo.png" />
    <link rel="apple-touch-icon" href="/brand/kuwait-logo.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="يحدث في الكويت — خلاصة المقالات"
      href="/rss.xml"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />
    <meta property="og:site_name" content="يحدث في الكويت" />
    <meta property="og:locale" content="ar_KW" />
    {article && (
      <>
        <meta property="article:published_time" content={article.date} />
        <meta property="article:modified_time" content={article.dateModified || dateModified || article.date} />
        {article.category && <meta property="article:section" content={article.category} />}
        <meta property="article:author" content={article.author} />
      </>
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, canonicalURL)} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data (Entity SEO Architecture) -->
    {articleSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    )}
    {websiteSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    )}
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
  </head>
  <body class="bg-[#f4f0e7] text-[#18323c] grain min-h-screen flex flex-col antialiased">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <SearchModal />
  </body>
</html>

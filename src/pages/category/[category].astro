---
import Layout from '@/layouts/Layout.astro';
import StoryCard from '@/components/StoryCard.astro';
import { stories, categories, type Category } from '@/data/stories';
import { ArrowRight, Tag, BookOpen, Clock } from 'lucide-astro';

export const prerender = true;

export function getStaticPaths() {
  const validCategories = categories.filter((c) => c !== 'الكل');
  return validCategories.map((cat) => ({
    params: { category: cat },
    props: { category: cat },
  }));
}

interface Props {
  category: Category;
}

const { category } = Astro.props;

const categoryDescriptions: Record<string, string> = {
  'أهل الديرة': 'شخصيات ملهمة، رواد، حرفيون، وقصص إنسانية صنعت روح الكويت وتراثها الحي.',
  'في الفريج': 'أسواق قديمة، بيوت تراثية، فرجان عتيقة، ومقاهٍ شعبية تحفظ أصالة المكان.',
  'سوالف وتراث': 'حكايات البحر والغوص، عادات البيوت، لهجة ومفردات أهل الكويت، وأمثال الطيبين.',
  'سفرة الديرة': 'أكلات البيت الكويتي القديم، طقوس الريوق المهيّل، واستكانة الشاي وسفرة البركة.',
  'ألبوم الذاكرة': 'صور نادرة، وثائق قديمة، وذكريات توثق معالم الكويت وتاريخها الجميل.',
};

const categoryStories = stories.filter((s) => s.category === category);
const desc = categoryDescriptions[category] || `جميع الحكايات والتقارير المصنفة تحت ${category}.`;
---

<Layout
  title={`حكايات ${category} — يحدث في الكويت`}
  description={desc}
>
  <div class="max-w-[1320px] mx-auto px-5 md:px-10 py-10 md:py-14">
    <!-- Breadcrumb & Header -->
    <div class="mb-8 border-b border-[#d9d1c2] pb-8">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-[13px] font-medium text-[#647170] hover:text-[#126447] mb-6 transition-colors"
      >
        <ArrowRight class="w-4 h-4" />
        <span>الصفحة الرئيسية</span>
      </a>

      <div class="flex items-center gap-2 text-[12px] font-semibold text-[#126447] mb-2 uppercase tracking-wider">
        <Tag class="w-3.5 h-3.5" />
        <span>دفتر التصنيفات</span>
      </div>

      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <h1 class="text-[34px] md:text-[48px] font-bold text-[#18323c] tracking-tight">
            {category}
          </h1>
          <p class="text-[16px] text-[#637172] mt-2 max-w-[650px] leading-relaxed">
            {desc}
          </p>
        </div>
        <span class="text-[13px] text-[#8c8980] bg-white/70 px-3.5 py-1.5 rounded-full border border-[#d9d1c2] font-medium">
          {categoryStories.length} حكايات منشورة
        </span>
      </div>
    </div>

    <!-- Stories Grid or Empty State -->
    {categoryStories.length > 0 ? (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
        {categoryStories.map((story) => (
          <StoryCard story={story} />
        ))}
      </div>
    ) : (
      <div class="py-20 px-6 text-center border-2 border-dashed border-[#c9c1b3] rounded-2xl bg-white/40 max-w-2xl mx-auto my-6">
        <div class="w-14 h-14 rounded-full bg-[#e8e1d4] text-[#126447] grid place-items-center mx-auto mb-4">
          <BookOpen class="w-7 h-7" />
        </div>
        <h3 class="text-xl font-bold text-[#18323c]">حكايات «{category}» قيد الإعداد</h3>
        <p class="text-sm text-[#777b74] mt-2 max-w-md mx-auto leading-relaxed">
          نعمل حالياً على كتابة وتوثيق حكايات مميزة لهذا القسم. اشترك في رسالتنا الأسبوعية لتكون أول من يقرأها فور نشرها.
        </p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
          <a
            href="/#النشرة"
            class="bg-[#126447] hover:bg-[#0e5038] text-white text-xs font-semibold px-5 py-2.5 rounded-full transition-all"
          >
            اشترك في رسالتنا
          </a>
          <a
            href="/"
            class="text-[#18323c] hover:text-[#126447] text-xs font-semibold px-4 py-2.5 underline underline-offset-4"
          >
            العودة للرئيسية
          </a>
        </div>
      </div>
    )}
  </div>
</Layout>

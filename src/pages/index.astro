---
import Layout from '@/layouts/Layout.astro';
import FeaturedStory from '@/components/FeaturedStory.astro';
import StoryCard from '@/components/StoryCard.astro';
import { categories } from '@/data/stories';
import { remember } from '@/lib/cache';
import { getPublishedArticles } from '@/lib/articles';
import { ArrowLeft, Search, Quote, Users, MapPin, Anchor, Coffee, Image as ImageIcon, Sparkles } from 'lucide-astro';

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=60, s-maxage=300, stale-while-revalidate=86400'
);

const publishedRows = await remember('homepage_articles_list', 60, async () => {
  return await getPublishedArticles();
});

const allStories = publishedRows.map((a) => ({
  slug: a.slug,
  category: a.category,
  title: a.title,
  excerpt: a.excerpt,
  author: a.authorName,
  authorRole: a.authorRole,
  date: new Date(a.publishedAt || a.createdAt).toLocaleDateString('ar-KW', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }),
  read: a.readTime || '٥ دقائق',
  image: a.coverImage,
  location: a.location || 'الكويت',
  featured: a.isFeatured,
}));

const hasStories = allStories.length > 0;
const featuredStory = hasStories ? allStories.find((s) => s.featured) || allStories[0] : null;
const editorialPicks = hasStories ? allStories.slice(1, 4) : [];

// Categories metadata for presentation
const categoriesMeta = [
  {
    name: 'أهل الديرة',
    icon: Users,
    desc: 'شخصيات ملهمة، رواد، حرفيون، وقصص إنسانية صنعت روح الكويت وتراثها الحي.',
    color: '#126447',
  },
  {
    name: 'في الفريج',
    icon: MapPin,
    desc: 'أسواق قديمة، بيوت تراثية، فرجان عتيقة، ومقاهٍ شعبية تحفظ أصالة المكان.',
    color: '#cf3935',
  },
  {
    name: 'سوالف وتراث',
    icon: Anchor,
    desc: 'حكايات البحر والغوص، عادات البيوت، لهجة ومفردات أهل الكويت، وأمثال الطيبين.',
    color: '#18323c',
  },
  {
    name: 'سفرة الديرة',
    icon: Coffee,
    desc: 'أكلات البيت الكويتي القديم، طقوس الريوق المهيّل، واستكانة الشاي وسفرة البركة.',
    color: '#c27d38',
  },
  {
    name: 'ألبوم الذاكرة',
    icon: ImageIcon,
    desc: 'صور نادرة، وثائق قديمة، وذكريات توثق معالم الكويت وتاريخها الجميل.',
    color: '#2a5563',
  },
];
---

<Layout
  title="يحدث في الكويت — مجلة وثائقية عن تراث وحكايات المكان وأهله"
  description="مجلة وثائقية كويتية مستقلة؛ نوثق حكايات أهل الديرة، أسرار الفرجان القديمة، وأكلات وتراث وتاريخ الكويت الأصيل بالصور والوثائق النادرة."
>
  <div class="max-w-[1320px] mx-auto px-5 md:px-10">
    <!-- Hero Header Title Banner -->
    <section class="pt-8 md:pt-12 pb-7 border-b border-[#d9d1c2] flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div>
        <div class="text-[12px] tracking-widest text-[#126447] font-semibold mb-2 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#126447]"></span>
          المشهد من هنا — إصدار توثيقي
        </div>
        <h1 class="text-[36px] md:text-[52px] leading-[1.15] font-extrabold tracking-tight text-[#18323c]">
          الكويت، كما نعيشها ونذكرها.
        </h1>
      </div>
      <p class="max-w-[360px] text-[14px] md:text-[15px] leading-[1.9] text-[#72766f]">
        مجلة مستقلة توثق حكايات أهل الديرة، أسرار الفرجان القديمة، وعَبَق التراث الكويتي الأصيل.
      </p>
    </section>

    {hasStories ? (
      <!-- When stories exist: Hero Featured Story & Editorial Desk -->
      <>
        <section class="grid lg:grid-cols-[1.65fr_0.85fr] gap-8 lg:gap-10 py-8 md:py-12">
          {featuredStory && <FeaturedStory story={featuredStory} />}

          <aside class="flex flex-col bg-[#ede7dc]/60 rounded-lg p-6 border border-[#d9d1c2]/60">
            <div class="flex items-center justify-between pb-4 border-b border-[#d9d1c2]">
              <h2 class="text-[19px] font-bold text-[#18323c]">على طاولة التحرير</h2>
              <span class="text-[11px] text-[#8c8980] bg-white/70 px-2.5 py-0.5 rounded-full font-medium">مختاراتنا</span>
            </div>

            <div class="divide-y divide-[#d9d1c2]/70 flex-1">
              {editorialPicks.map((story, i) => (
                <div class="py-4 first:pt-4">
                  <div class="flex items-center gap-2 text-[11px] text-[#126447] mb-2 font-medium">
                    <span class="font-serif text-[16px] text-[#cf3935] font-bold">٠{i + 1}</span>
                    <span>{story.category}</span>
                    <span class="text-[#c8bda9]">·</span>
                    <span class="text-[#8c8980]">{story.location}</span>
                  </div>
                  <StoryCard story={story} compact={true} />
                </div>
              ))}
            </div>

            <a
              href="#كل-الحكايات"
              class="mt-4 pt-4 border-t border-[#d9d1c2]/60 flex items-center justify-between text-[13px] font-semibold text-[#126447] hover:text-[#0e5038] group"
            >
              <span>تصفح جميع الحكايات</span>
              <ArrowLeft class="w-4 h-4 transition-transform group-hover:-translate-x-1" />
            </a>
          </aside>
        </section>

        <!-- Category Filter Bar -->
        <section class="border-y border-[#d9d1c2] py-4 my-2 flex items-center gap-4 overflow-x-auto" aria-label="اختيار فئة">
          <span class="text-[12px] font-semibold text-[#8c8980] whitespace-nowrap">
            أقسام المجلة:
          <div class="flex items-center gap-2 min-w-max" id="category-filter-buttons">
            {categories.map((c) => (
              <a
                href={c === 'الكل' ? '#كل-الحكايات' : `/category/${encodeURIComponent(c)}`}
                class={`category-tab-btn rounded-full px-4 py-2 text-[13px] font-medium transition-all ${
                  c === 'الكل'
                    ? 'bg-[#18323c] text-[#f4f0e7] shadow-sm active-tab'
                    : 'bg-transparent text-[#546267] hover:bg-[#e8e1d4]'
                }`}
                data-category={c}
              >
                {c}
              </a>
            ))}
          </div>
        </section>

        <!-- Stories Grid -->
        <section id="كل-الحكايات" class="pt-10 pb-16 scroll-mt-24">
          <div id="stories-grid-container" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
            {allStories.map((story, idx) => (
              <div
                class={`story-grid-item ${idx >= 12 ? 'hidden' : ''}`}
                data-story-category={story.category}
                data-index={idx}
              >
                <StoryCard story={story} />
              </div>
            ))}
          </div>

          {allStories.length > 12 && (
            <div id="load-more-container" class="mt-14 text-center">
              <button
                id="load-more-btn"
                type="button"
                class="inline-flex items-center gap-3 bg-[#18323c] hover:bg-[#126447] text-[#f4f0e7] font-semibold text-[15px] px-8 py-3.5 rounded-full shadow-md hover:shadow-lg transition-all duration-300 cursor-pointer"
              >
                <span>عرض المزيد من الحكايات</span>
                <span class="w-6 h-6 rounded-full bg-white/20 text-xs flex items-center justify-center font-mono" id="remaining-count">
                  {allStories.length - 12}
                </span>
              </button>
            </div>
          )}
        </section>
      </>
    ) : (
      <!-- Empty State: Ready for real articles with 5 Categories Presentation -->
      <section class="py-12 md:py-16">
        <!-- Coming Soon Editorial Card -->
        <div class="relative bg-gradient-to-br from-[#18323c] to-[#254652] text-[#f4f0e7] rounded-3xl p-8 md:p-14 overflow-hidden shadow-xl mb-14 border border-[#2b4c59]">
          <div class="absolute -left-12 -bottom-12 w-80 h-80 rounded-full bg-[#126447]/20 blur-3xl pointer-events-none"></div>
          <div class="relative z-10 max-w-2xl">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-md text-[#b8d3c2] text-xs font-semibold mb-6">
              <Sparkles class="w-3.5 h-3.5" />
              <span>مساحة توثيقية قيد التحضير</span>
            </div>
            <h2 class="text-[30px] md:text-[44px] font-bold leading-[1.25] text-white">
              نجهّز لكم حكايات تليق بالكويت وأهلها.
            </h2>
            <p class="text-[15px] md:text-[17px] text-white/80 leading-[1.9] mt-4">
              أفرغنا المدونة من المقالات التجريبية، لنبدأ معكم مرحلة النشر الحقيقي؛ نوثق سِيَر الشخصيات الملهمة، نفتح أبواب البيوت والفرجان القديمة، ونعيد رواية سوالف البحر والتراث الكويتي الأصيل.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-4">
              <a
                href="#أقسام-المجلة"
                class="inline-flex items-center gap-2 bg-[#126447] hover:bg-[#0e5038] text-white px-6 py-3 rounded-full text-sm font-semibold shadow-lg hover:shadow transition-all"
              >
                <span>استكشف أقسام وحكايات المجلة</span>
                <ArrowLeft class="w-4 h-4" />
              </a>
              <a
                href="#عن-المجلة"
                class="inline-flex items-center gap-2 text-white/80 hover:text-white px-4 py-3 text-sm font-medium transition-colors"
              >
                <span>عن المجلة ورؤيتنا ←</span>
              </a>
            </div>
          </div>
        </div>

        <!-- 5 Core Categories Showcase -->
        <div id="أقسام-المجلة" class="scroll-mt-20">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-8 pb-4 border-b border-[#d9d1c2]">
            <div>
              <span class="text-[12px] font-semibold text-[#126447] tracking-wider uppercase">محاور المجلة</span>
              <h3 class="text-[24px] md:text-[32px] font-bold text-[#18323c] mt-1">خماسية «يحدث في الكويت»</h3>
            </div>
            <span class="text-xs text-[#8c8980]">التصنيفات المعتمدة للمقالات القادمة</span>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {categoriesMeta.map((cat, idx) => {
              const IconComp = cat.icon;
              return (
                <a
                  href={`/category/${encodeURIComponent(cat.name)}`}
                  class="group block bg-[#ede7dc]/70 hover:bg-white p-7 rounded-2xl border border-[#d9d1c2] hover:border-[#126447] shadow-sm hover:shadow-md transition-all text-right no-underline"
                >
                  <div class="flex items-center justify-between mb-4">
                    <div class="w-12 h-12 rounded-xl bg-white group-hover:bg-[#f4f0e7] grid place-items-center text-[#18323c] border border-[#d9d1c2] transition-colors shadow-xs">
                      <IconComp class="w-6 h-6" style={`color: ${cat.color};`} />
                    </div>
                    <span class="text-xs font-serif font-bold text-[#8c8980]">٠{idx + 1}</span>
                  </div>
                  <h4 class="text-[20px] font-bold text-[#18323c] group-hover:text-[#126447] transition-colors">
                    {cat.name}
                  </h4>
                  <p class="text-[13px] text-[#6a7576] leading-[1.8] mt-2.5">
                    {cat.desc}
                  </p>
                  <div class="mt-5 flex items-center gap-1.5 text-xs font-semibold text-[#126447]">
                    <span>تصفح القسم</span>
                    <span class="transition-transform group-hover:-translate-x-1">←</span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    )}

    <!-- Editorial Quote Section -->
    <section class="grid md:grid-cols-[0.9fr_1.1fr] my-12 bg-[#e8e1d4] rounded-2xl overflow-hidden shadow-sm border border-[#d9d1c2]/70">
      <div class="relative min-h-[280px] overflow-hidden">
        <img
          src="/images/breakfast.jpg"
          alt="مائدة فطور كويتية"
          class="absolute inset-0 w-full h-full object-cover"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-[#18323c]/20"></div>
      </div>
      <div class="p-8 md:p-14 flex flex-col justify-center">
        <div class="flex items-center gap-2 text-[#126447] text-[12px] font-semibold tracking-wider">
          <Quote class="w-4 h-4" />
          <span>من دفتر المكان</span>
        </div>
        <blockquote class="text-[22px] md:text-[30px] leading-[1.7] font-bold text-[#18323c] mt-3">
          «الأماكن ما تعيش بحيطانها، تعيش بالناس اللي يردّون لها.»
        </blockquote>
        <span class="text-[13px] text-[#7e7c73] mt-3">
          من دفتر حكايات أهل الكويت
        </span>
      </div>
    </section>

    <!-- About The Magazine Section -->
    <section
      id="عن-المجلة"
      class="py-16 md:py-20 border-t border-[#d9d1c2] grid md:grid-cols-2 gap-10 items-center scroll-mt-20"
    >
      <div>
        <span class="text-[12px] font-semibold tracking-widest text-[#126447] uppercase">
          ليش نكتب؟
        </span>
        <h2 class="text-[32px] md:text-[44px] font-bold leading-[1.3] text-[#18323c] mt-2.5">
          لأن كل فريج وشارع<br />عنده سالفة وإنسان.
        </h2>
      </div>
      <div class="space-y-4 text-[15px] md:text-[16px] leading-[2.1] text-[#55656b]">
        <p>
          «يحدث في الكويت» مساحة توثيقية مستقلة تروي حكايات المكان وأهله. نكتب عن رواد صنعوا بجهدهم ملامح الديرة، وعن فرجان قديمة وبراحات لا تزال تتنفس ذكريات الطين والبحر، وعن سوالف وتراث وأكلات ارتبطت في ذاكرتنا بالبركة والجمعة الطيبة.
        </p>
        <p>
          هدفنا أن نحفظ هذه الحكايات بأناقة، مكتوبةً ومصوّرةً، لتبقى حية في ذاكرة الأجيال القادمة.
        </p>
      </div>
    </section>
  </div>
</Layout>

<script>
  const filterTabs = document.querySelectorAll('.category-tab-btn');
  const allStoryItems = Array.from(document.querySelectorAll('.story-grid-item'));
  const loadMoreBtn = document.getElementById('load-more-btn');
  const loadMoreContainer = document.getElementById('load-more-container');
  const remainingCountBadge = document.getElementById('remaining-count');

  let activeCategory = 'الكل';
  let visibleCount = 12;
  const BATCH_SIZE = 12;

  function updateGridDisplay() {
    const matchingItems = allStoryItems.filter((item) => {
      const cat = item.getAttribute('data-story-category');
      return activeCategory === 'الكل' || cat === activeCategory;
    });

    const nonMatchingItems = allStoryItems.filter((item) => {
      const cat = item.getAttribute('data-story-category');
      return activeCategory !== 'الكل' && cat !== activeCategory;
    });

    nonMatchingItems.forEach((el) => el.classList.add('hidden'));

    matchingItems.forEach((el, idx) => {
      if (idx < visibleCount) {
        el.classList.remove('hidden');
      } else {
        el.classList.add('hidden');
      }
    });

    const remaining = Math.max(0, matchingItems.length - visibleCount);
    if (loadMoreContainer) {
      if (remaining > 0) {
        loadMoreContainer.style.display = '';
        if (remainingCountBadge) {
          remainingCountBadge.textContent = String(remaining);
        }
      } else {
        loadMoreContainer.style.display = 'none';
      }
    }
  }

  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', () => {
      visibleCount += BATCH_SIZE;
      updateGridDisplay();
    });
  }

  filterTabs.forEach((tab) => {
    tab.addEventListener('click', (e) => {
      const category = tab.getAttribute('data-category');
      if (!category) return;
      e.preventDefault();

      filterTabs.forEach((t) => {
        t.classList.remove('bg-[#18323c]', 'text-[#f4f0e7]', 'shadow-sm', 'active-tab');
        t.classList.add('bg-transparent', 'text-[#546267]');
      });

      tab.classList.add('bg-[#18323c]', 'text-[#f4f0e7]', 'shadow-sm', 'active-tab');
      tab.classList.remove('bg-transparent', 'text-[#546267]');

      activeCategory = category;
      visibleCount = 12;
      updateGridDisplay();
    });
  });
</script>


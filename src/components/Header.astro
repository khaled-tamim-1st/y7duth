---
import { categories } from '@/data/stories';
import { Search, Menu, X } from 'lucide-astro';

const navCategories = categories.filter((c) => c !== 'الكل');

// Initial server-side Kuwait Date & Time (SSR / Pre-render)
const now = new Date();
const initialDate = new Intl.DateTimeFormat('ar-KW', {
  timeZone: 'Asia/Kuwait',
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(now);

const initialTime = new Intl.DateTimeFormat('ar-KW', {
  timeZone: 'Asia/Kuwait',
  hour: 'numeric',
  minute: '2-digit',
  second: '2-digit',
  hour12: true,
}).format(now);
---

<!-- Top Date, Clock & Weather Ribbon -->
<div class="bg-[#18323c] text-[#f5f0e6] text-[11px] md:text-xs border-b border-[#24424e]">
  <div class="max-w-[1320px] mx-auto px-5 md:px-10 min-h-9 py-1 flex flex-wrap items-center justify-between gap-y-1 gap-x-4">
    <!-- Live Kuwait Indicators (Date, Clock, Weather) -->
    <div class="flex items-center flex-wrap gap-2 md:gap-3">
      <!-- Live Date -->
      <span id="kuwait-live-date" class="tracking-wide font-medium flex items-center gap-1.5" title="تاريخ اليوم في الكويت">
        <span class="date-text">{initialDate}</span>
      </span>

      <span class="inline-block w-1.5 h-1.5 rounded-full bg-[#cf3935]" aria-hidden="true"></span>

      <!-- Live Clock -->
      <span
        id="kuwait-live-time"
        class="tracking-wide font-medium text-[#b8d3c2] flex items-center gap-1.5"
        title="توقيت الكويت الحي"
      >
        <span class="inline-block w-2 h-2 rounded-full bg-[#126447] animate-pulse" aria-hidden="true"></span>
        <span class="time-text font-mono font-semibold">{initialTime}</span>
        <span class="text-[10px] text-white/60 hidden sm:inline">توقيت الكويت</span>
      </span>

      <span class="inline-block w-1 h-1 rounded-full bg-white/30 hidden sm:inline-block" aria-hidden="true"></span>

      <!-- Live Weather -->
      <span
        id="kuwait-live-temp"
        class="tracking-wide font-medium flex items-center gap-1.5 text-white/90"
        title="الطقس ودرجة الحرارة في مدينة الكويت الآن"
      >
        <span class="weather-icon text-xs">☀️</span>
        <span class="temp-text">الكويت ٣٩°م</span>
        <span class="weather-condition text-white/60 text-[10px] hidden md:inline">صافٍ</span>
      </span>
    </div>

    <!-- Magazine Slogan -->
    <div class="hidden sm:flex items-center gap-2 text-white/60 font-light text-[11px]">
      <span>حكايات من هنا، تُروى كما هي</span>
    </div>
  </div>
</div>

<!-- Main Header -->
<header class="bg-[#f4f0e7] border-b border-[#d9d1c2] sticky top-0 z-30 backdrop-blur-md bg-opacity-95">
  <div class="max-w-[1320px] mx-auto px-5 md:px-10 h-[88px] flex items-center justify-between gap-4">
    <!-- Brand Logo & Categories Nav -->
    <div class="flex items-center gap-7 xl:gap-9">
      <a href="/" class="flex items-center group no-underline" aria-label="يحدث في الكويت - الصفحة الرئيسية">
        <img
          src="/brand/kuwait-logo.png"
          alt="يحدث في الكويت"
          class="w-14 h-14 md:w-16 md:h-16 object-contain flex-shrink-0 transition-transform duration-300 group-hover:scale-105"
          width="64"
          height="64"
        />
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center gap-6 xl:gap-7 text-[15px] text-[#41535a] font-medium" aria-label="التنقل الرئيسي">
        {navCategories.map((cat) => (
          <a
            href={`/category/${encodeURIComponent(cat)}`}
            class="hover:text-[#126447] relative py-1 transition-colors after:content-[''] after:absolute after:bottom-0 after:right-0 after:w-0 after:h-[2px] after:bg-[#126447] hover:after:w-full after:transition-all"
          >
            {cat}
          </a>
        ))}
        <a
          href="/#عن-المجلة"
          class="hover:text-[#126447] relative py-1 transition-colors after:content-[''] after:absolute after:bottom-0 after:right-0 after:w-0 after:h-[2px] after:bg-[#126447] hover:after:w-full after:transition-all"
        >
          عن المجلة
        </a>
      </nav>
    </div>

    <!-- Header Actions -->
    <div class="flex items-center gap-2.5">
      <!-- Search Trigger Button -->
      <button
        id="open-search-btn"
        type="button"
        aria-label="ابحث في الحكايات"
        class="h-10 w-10 grid place-items-center rounded-full hover:bg-[#e8e1d4] text-[#18323c] transition-colors"
      >
        <Search class="w-5 h-5" />
      </button>

      <!-- Browse Stories Link -->
      <a
        href="/#أقسام-المجلة"
        class="hidden sm:inline-flex items-center justify-center bg-[#126447] text-[#f4f0e7] rounded-full px-5 py-2.5 text-[13px] font-medium hover:bg-[#0e5038] shadow-sm hover:shadow transition-all"
      >
        تصفح الحكايات
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="فتح القائمة"
        class="lg:hidden h-10 w-10 grid place-items-center rounded-full hover:bg-[#e8e1d4] text-[#18323c]"
      >
        <Menu class="w-5 h-5 menu-open-icon" />
        <X class="w-5 h-5 menu-close-icon hidden" />
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <nav
    id="mobile-menu"
    class="hidden lg:hidden border-t border-[#d9d1c2] bg-[#f4f0e7] px-6 py-4 shadow-lg animate-fadeIn"
    aria-label="قائمة الهاتف"
  >
    <div class="grid grid-cols-2 gap-3 pb-3">
      {navCategories.map((cat) => (
        <a
          href={`/category/${encodeURIComponent(cat)}`}
          class="py-2.5 px-3 rounded-lg text-[#18323c] hover:bg-[#e8e1d4] hover:text-[#126447] font-medium text-sm transition-colors"
        >
          {cat}
        </a>
      ))}
      <a
        href="/#عن-المجلة"
        class="py-2.5 px-3 rounded-lg text-[#18323c] hover:bg-[#e8e1d4] hover:text-[#126447] font-medium text-sm transition-colors"
      >
        عن المجلة
      </a>
    </div>
    <div class="pt-3 border-t border-[#d9d1c2]/60">
      <a
        href="/#أقسام-المجلة"
        class="block text-center bg-[#126447] text-[#f4f0e7] rounded-full py-2.5 text-sm font-medium hover:bg-[#0e5038]"
      >
        استكشف أقسام المجلة
      </a>
    </div>
  </nav>
</header>

<script>
  // Mobile Menu Logic
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const openIcon = mobileMenuBtn?.querySelector('.menu-open-icon');
  const closeIcon = mobileMenuBtn?.querySelector('.menu-close-icon');

  mobileMenuBtn?.addEventListener('click', () => {
    const isExpanded = mobileMenu?.classList.toggle('hidden') === false;
    openIcon?.classList.toggle('hidden', isExpanded);
    closeIcon?.classList.toggle('hidden', !isExpanded);
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    });
  });

  // --- Real-time Kuwait Clock & Date Synchronization ---
  const dateText = document.querySelector('#kuwait-live-date .date-text');
  const timeText = document.querySelector('#kuwait-live-time .time-text');

  function tickKuwaitTime() {
    const now = new Date();

    // Live Date (formatted in Arabic with Kuwait timezone)
    const formattedDate = new Intl.DateTimeFormat('ar-KW', {
      timeZone: 'Asia/Kuwait',
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    }).format(now);

    // Live Time (formatted with seconds & Kuwait timezone)
    const formattedTime = new Intl.DateTimeFormat('ar-KW', {
      timeZone: 'Asia/Kuwait',
      hour: 'numeric',
      minute: '2-digit',
      second: '2-digit',
      hour12: true,
    }).format(now);

    if (dateText && dateText.textContent !== formattedDate) {
      dateText.textContent = formattedDate;
    }
    if (timeText) {
      timeText.textContent = formattedTime;
    }
  }

  // Run immediately and update every second
  tickKuwaitTime();
  setInterval(tickKuwaitTime, 1000);

  // --- Real-time Kuwait Weather & Temperature Synchronization ---
  const tempText = document.querySelector('#kuwait-live-temp .temp-text');
  const weatherIcon = document.querySelector('#kuwait-live-temp .weather-icon');
  const weatherCondition = document.querySelector('#kuwait-live-temp .weather-condition');

  interface CachedWeather {
    tempC: number;
    code: number;
    timestamp: number;
  }

  function applyWeatherDisplay(tempC: number, code: number) {
    const arabicTemp = new Intl.NumberFormat('ar-KW').format(tempC);
    if (tempText) tempText.textContent = `الكويت ${arabicTemp}°م`;

    let icon = '☀️';
    let cond = 'مشمس';

    if (code === 0) {
      icon = '☀️';
      cond = 'صافٍ';
    } else if (code >= 1 && code <= 3) {
      icon = '🌤️';
      cond = 'غائم جزئيًا';
    } else if (code === 45 || code === 48) {
      icon = '🌫️';
      cond = 'ضباب';
    } else if (code >= 51 && code <= 67) {
      icon = '🌧️';
      cond = 'ممطر';
    } else if (code >= 80 && code <= 82) {
      icon = '🌦️';
      cond = 'زخات مطر';
    } else if (code >= 95) {
      icon = '⛈️';
      cond = 'عواصف رعدية';
    }

    if (weatherIcon) weatherIcon.textContent = icon;
    if (weatherCondition) weatherCondition.textContent = cond;
  }

  async function syncKuwaitWeather() {
    try {
      // Check cache for 15 minutes validity
      const cachedStr = sessionStorage.getItem('kuwait_weather');
      if (cachedStr) {
        try {
          const cached: CachedWeather = JSON.parse(cachedStr);
          if (Date.now() - cached.timestamp < 15 * 60 * 1000) {
            applyWeatherDisplay(cached.tempC, cached.code);
            return;
          }
        } catch {
          sessionStorage.removeItem('kuwait_weather');
        }
      }

      // Fetch live temperature from Open-Meteo for Kuwait City
      const res = await fetch(
        'https://api.open-meteo.com/v1/forecast?latitude=29.3759&longitude=47.9774&current=temperature_2m,weather_code&timezone=Asia%2FKuwait'
      );
      if (!res.ok) return;

      const data = await res.json();
      if (data?.current?.temperature_2m !== undefined) {
        const tempC = Math.round(data.current.temperature_2m);
        const code = Number(data.current.weather_code ?? 0);

        sessionStorage.setItem(
          'kuwait_weather',
          JSON.stringify({ tempC, code, timestamp: Date.now() })
        );
        applyWeatherDisplay(tempC, code);
      }
    } catch (e) {
      console.debug('Kuwait weather sync notice:', e);
    }
  }

  // Sync weather on load and refresh every 15 minutes
  syncKuwaitWeather();
  setInterval(syncKuwaitWeather, 15 * 60 * 1000);
</script>
